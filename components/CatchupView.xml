<?xml version="1.0" encoding="utf-8" ?>
<!-- Lista de programas ja exibidos de um canal com arquivo (rever). -->
<component name="CatchupView" extends="Group">
  <interface>
    <field id="channel" type="assocarray" />
    <field id="programmes" type="array" onChange="onProgrammesChanged" />
    <field id="loading" type="boolean" value="false" onChange="onProgrammesChanged" />
    <field id="message" type="string" value="" onChange="onProgrammesChanged" />
    <field id="programmeSelected" type="assocarray" alwaysNotify="true" />
    <function name="handleKey" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/CatchupView.brs" />
  <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/TextUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/Catchup.brs" />
