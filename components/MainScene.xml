<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="deepLink" type="assocarray" alwaysNotify="true" />
    <field id="memoryWarning" type="boolean" alwaysNotify="true" />
    <field id="memoryInfo" type="assocarray" />
    <field id="languageRequested" type="boolean" alwaysNotify="true" onChange="onLanguageRequested" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <script type="text/brightscript" uri="pkg:/source/I18n.brs" />
  <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/TextUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/QrCode.brs" />
  <children>
    <!-- Fundo: arte limpa + degradê escuro só à esquerda (sem véu azul) -->
    <Rectangle width="1920" height="1080" color="0x070B14FF" />
    <Poster id="background" uri="pkg:/images/elvanoq-login-tv-backdrop.jpg" width="1920" height="1080" />
    <Rectangle id="ambientBottom" width="1920" height="1080" color="0x070B14FF" opacity="0" />
    <Poster id="loginShade" uri="pkg:/images/hero_shade_left.png" width="2300" height="1080" />
    <Poster id="loginShadeBottom" uri="pkg:/images/hero_shade_bottom.png" width="1920" height="1080" opacity="0.55" />

    <!-- Ativacao no redesign (canvas "Proposta visual Login e Ativacao", tela 3): coluna a esquerda, QR num cartao a direita -->
    <Poster id="brandMark" uri="pkg:/images/elvanoq-logo-tagline.png" translation="[96,64]" width="330" height="80" loadDisplayMode="scaleToFit" />
    <Timer id="clockTimer" duration="20" repeat="true" />
    <Label id="clockTime" translation="[1460,64]" width="364" height="54" horizAlign="right" />
    <Label id="clockDate" translation="[1460,120]" width="364" height="28" horizAlign="right" />
    <!-- Idioma (canvas "Idioma do aplicativo", tela 9): pilula a 36 px do relogio -->
    <Group id="languagePill" translation="[1300,79]">
      <RoundRect id="languagePillBg" width="260" height="56" color="0x0E1524EB" radius="28" />
      <Poster id="languageGlobe" uri="pkg:/images/icon_language.png" translation="[18,15]" width="26" height="26" blendColor="0x00D7FFFF" />
      <Label id="languageLabel" translation="[56,0]" height="56" vertAlign="center" />
      <Poster id="languageChevron" uri="pkg:/images/icon_chevron_down.png" width="20" height="20" />
    </Group>
    <Label id="textMeasure" visible="false" />

    <Label id="eyebrow" translation="[96,246]" text="ACESSO SEGURO" width="900" height="26" />
    <Label id="headline" translation="[96,282]" text="Ative sua TV" width="1000" height="84" />
    <Label id="description" translation="[96,374]" text="Vincule esta TV ao Portal ELVANOQ Play em três passos." width="1000" height="36" />

    <Group id="stepsGroup" translation="[96,446]">
      <Poster uri="pkg:/images/step_circle.png" width="44" height="44" blendColor="0x1A2438FF" />
      <Label id="stepNumber1" text="1" width="44" height="44" horizAlign="center" vertAlign="center" />
      <Label id="stepText1" translation="[64,0]" text="Aponte a câmera para o QR ou acesse elvanoqplay.app" width="900" height="44" vertAlign="center" />
      <Poster translation="[0,66]" uri="pkg:/images/step_circle.png" width="44" height="44" blendColor="0x1A2438FF" />
      <Label id="stepNumber2" translation="[0,66]" text="2" width="44" height="44" horizAlign="center" vertAlign="center" />
      <Label id="stepText2" translation="[64,66]" text="Informe o código desta TV" width="900" height="44" vertAlign="center" />
      <Poster translation="[0,132]" uri="pkg:/images/step_circle.png" width="44" height="44" blendColor="0x1A2438FF" />
      <Label id="stepNumber3" translation="[0,132]" text="3" width="44" height="44" horizAlign="center" vertAlign="center" />
      <Label id="stepText3" translation="[64,132]" text="A TV ativa sozinha em alguns segundos" width="900" height="44" vertAlign="center" />
    </Group>

    <Label id="portalCaption" translation="[96,630]" text="" width="700" height="26" visible="false" />
    <RoundRect id="codeBorder" translation="[96,672]" width="760" height="114" color="0x00000000" radius="20" stroke="3" />
    <RoundRect id="codeCard" translation="[96,672]" width="760" height="114" color="0x0E1524EB" radius="20" />
    <Label id="codeLabel" translation="[126,690]" text="CÓDIGO DESTA TV" width="700" height="24" />
    <Label id="deviceCode" translation="[126,720]" width="700" height="48" vertAlign="center" />

    <Group id="qrGroup" translation="[1380,370]">
      <RoundRect translation="[-80,-40]" width="460" height="480" color="0x0E1524FF" radius="28" />
      <RoundRect width="300" height="300" color="0xFFFFFFFF" radius="18" />
      <Poster id="qrStatic" uri="pkg:/images/qr_portal.png" translation="[18,18]" width="264" height="264" />
      <Group id="qrModules" translation="[18,18]" />
      <Label id="qrCaption" translation="[-80,320]" text="Aponte a câmera do celular" width="460" height="30" horizAlign="center" />
    </Group>
    <Label id="portal" translation="[1300,736]" text="elvanoqplay.app" width="460" height="36" horizAlign="center" />

    <!-- Acoes: botao principal branco e dois atalhos (foco por setas) -->
    <RoundRect id="serverCodeButton" translation="[96,808]" width="760" height="76" color="0x00D7FFFF" radius="16" stroke="3" />
    <RoundRect id="serverCodeInner" translation="[96,808]" width="760" height="76" color="0xF4F8FFFF" radius="16" />
    <Poster id="serverCodeIcon" uri="pkg:/images/icon_key.png" translation="[0,832]" width="28" height="28" blendColor="0x070B14FF" />
    <Label id="serverCodeButtonText" translation="[96,808]" text="Entrar com código do servidor" width="760" height="76" horizAlign="center" vertAlign="center" />
    <Group id="serverCodeAction" translation="[96,808]" />

    <RoundRect id="checkButton" translation="[96,900]" width="372" height="60" color="0x0E1524EB" radius="14" />
    <Poster id="checkIcon" uri="pkg:/images/icon_refresh.png" translation="[0,918]" width="24" height="24" blendColor="0x00D7FFFF" />
    <Label id="checkButtonText" translation="[96,900]" text="Verificar ativação" width="372" height="60" horizAlign="center" vertAlign="center" />
    <RoundRect id="helpButton" translation="[484,900]" width="372" height="60" color="0x0E1524EB" radius="14" />
    <Poster id="helpIcon" uri="pkg:/images/icon_info.png" translation="[0,918]" width="24" height="24" blendColor="0x00D7FFFF" />
    <Label id="helpButtonText" translation="[484,900]" text="Como ativar" width="372" height="60" horizAlign="center" vertAlign="center" />

    <Poster id="statusDot" uri="pkg:/images/status_dot.png" translation="[96,1006]" width="12" height="12" blendColor="0x00D7FFFF" />
    <Animation id="statusPulse" duration="1.4" repeat="true" easeFunction="inOutQuad">
      <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[1.0, 0.25, 1.0]" fieldToInterp="statusDot.opacity" />
    </Animation>
    <Label id="status" translation="[120,992]" text="Preparando ativação…" width="1000" height="40" vertAlign="center" />

    <!-- Aviso de teste encerrado / sem licenca (sem pagamento nem link externo) -->
    <Group id="expiredOverlay" visible="false">
      <Rectangle width="1920" height="1080" color="0x02070DEB" />
      <RoundRect translation="[300,150]" width="1320" height="780" color="0x0B121EFF" radius="28" borderColor="0xBEDCFF33" />
      <Poster translation="[810,196]" width="300" height="100" uri="pkg:/images/elvanoq-logo.png" />
      <Label id="expiredTitle" translation="[300,330]" width="1320" height="60" horizAlign="center" text="Seu teste gratuito terminou" />
      <Label id="expiredMessage" translation="[420,400]" width="1080" height="72" horizAlign="center" wrap="true" maxLines="2" text="Este aparelho ainda não possui uma licença ativa. Assim que a licença for ativada, a TV libera o acesso automaticamente." />
      <Label id="expiredCaption" translation="[300,506]" width="1320" height="26" horizAlign="center" text="CÓDIGO DESTE APARELHO" />
      <RoundRect translation="[560,544]" width="800" height="104" color="0x00D7FFFF" radius="18" stroke="3" />
      <RoundRect translation="[563,547]" width="794" height="98" color="0x0D1422FF" radius="16" />
      <Label id="expiredCode" translation="[563,547]" width="794" height="98" horizAlign="center" vertAlign="center" />
      <Label id="expiredInfo" translation="[300,672]" width="1320" height="30" horizAlign="center" text="A ativação é verificada automaticamente a cada minuto." />
      <RoundRect translation="[740,738]" width="440" height="72" color="0xF4F8FFFF" radius="28" />
      <Label id="expiredButton" translation="[740,738]" width="440" height="72" horizAlign="center" vertAlign="center" text="OK   •   Verificar agora" />
      <Label id="expiredFooter" translation="[300,852]" width="1320" height="28" horizAlign="center" text="Voltar   •   Sair do aplicativo" />
    </Group>
    <!-- Bem-vindo de volta (mesmo do Android TV, LG e MSX): fundo do login, a
         lista em uso e uma barra de 1,2 s; entra sozinho, sem apertar nada. -->
    <Group id="welcomeOverlay" visible="false">
      <Poster uri="pkg:/images/elvanoq-login-tv-backdrop.jpg" width="1920" height="1080" />
      <Poster uri="pkg:/images/hero_shade_left.png" width="2300" height="1080" />
      <Poster uri="pkg:/images/elvanoq-logo-tagline.png" translation="[112,72]" width="400" height="97" loadDisplayMode="scaleToFit" />
      <Poster uri="pkg:/images/status_dot.png" translation="[112,345]" width="14" height="14" blendColor="0x00D7FFFF" />
      <Label id="welcomeStatus" translation="[140,332]" text="TV vinculada ao Portal" width="900" height="40" vertAlign="center" />
      <Label id="welcomeTitle" translation="[112,380]" text="Bem-vindo de volta" width="1200" height="84" />
      <Label id="welcomeSubtitle" translation="[112,470]" text="Entrando na sua lista…" width="1000" height="40" />
      <RoundRect translation="[112,550]" width="760" height="190" color="0x0E1524EB" radius="24" />
      <RoundRect translation="[142,580]" width="76" height="76" color="0x1A2438FF" radius="20" />
      <Label id="welcomeInitial" translation="[142,580]" width="76" height="76" horizAlign="center" vertAlign="center" />
      <Label id="welcomeName" translation="[242,584]" width="600" height="40" />
      <Label id="welcomeInfo" translation="[242,626]" text="Lista em uso" width="600" height="30" />
      <Rectangle translation="[142,690]" width="700" height="6" color="0xF4F8FF24" />
      <Rectangle id="welcomeBar" translation="[142,690]" width="0" height="6" color="0x00D7FFFF" />
    </Group>
    <Animation id="welcomeAnimation" duration="1.2" repeat="false" easeFunction="outQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 700.0]" fieldToInterp="welcomeBar.width" />
    </Animation>
    <!-- Escolha do idioma (canvas "Idioma do aplicativo", tela 10) -->
    <Group id="languageOverlay" visible="false" focusable="true">
      <Rectangle width="1920" height="1080" color="0x03060CC7" />
      <RoundRect translation="[600,283]" width="720" height="514" color="0x0E1524FF" radius="28" />
      <Poster uri="pkg:/images/icon_language.png" translation="[666,331]" width="32" height="32" blendColor="0x00D7FFFF" />
      <Label id="languageTitle" translation="[712,327]" text="Idioma do aplicativo" width="560" height="40" vertAlign="center" />
      <Label id="languageText" translation="[666,379]" text="Muda os textos do app. O áudio e as legendas dos vídeos continuam os da sua lista." width="588" height="56" wrap="true" maxLines="2" />
      <RoundRect id="languageOption0" translation="[640,453]" width="640" height="84" color="0x00000000" radius="18" />
      <Label id="languageOptionLabel0" translation="[666,467]" width="520" height="32" />
      <Label id="languageOptionSub0" translation="[666,501]" width="520" height="24" />
      <Poster id="languageOptionCheck0" uri="pkg:/images/icon_check.png" translation="[1226,481]" width="28" height="28" visible="false" />
      <RoundRect id="languageOption1" translation="[640,547]" width="640" height="84" color="0x00000000" radius="18" />
      <Label id="languageOptionLabel1" translation="[666,561]" width="520" height="32" />
      <Label id="languageOptionSub1" translation="[666,595]" width="520" height="24" />
      <Poster id="languageOptionCheck1" uri="pkg:/images/icon_check.png" translation="[1226,575]" width="28" height="28" visible="false" />
      <RoundRect id="languageOption2" translation="[640,641]" width="640" height="84" color="0x00000000" radius="18" />
      <Label id="languageOptionLabel2" translation="[666,655]" width="520" height="32" />
      <Label id="languageOptionSub2" translation="[666,689]" width="520" height="24" />
      <Poster id="languageOptionCheck2" uri="pkg:/images/icon_check.png" translation="[1226,669]" width="28" height="28" visible="false" />
      <Label id="languageHint" translation="[666,741]" text="OK escolher   •   Voltar fechar" width="588" height="24" />
    </Group>
    <Label id="homeStatus" translation="[225,510]" width="1470" height="75" horizAlign="center" visible="false" />
    <Label id="appVersion" translation="[1224,994]" text="ELVANOQ · Roku · Versão 1.1.4" width="600" height="36" horizAlign="right" vertAlign="center" />
    <Timer id="registerTimer" repeat="false" duration="3" />
    <Timer id="licenseTimer" repeat="true" duration="60" />
    <Timer id="portalWatchdog" repeat="false" duration="20" />
  </children>
</component>
