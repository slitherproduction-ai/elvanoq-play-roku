<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerView" extends="Group">
  <interface>
    <field id="streamUrl" type="string" />
    <field id="contentId" type="string" />
    <field id="contentTitle" type="string" />
    <field id="contentCategory" type="string" />
    <field id="resumePosition" type="integer" value="0" />
    <field id="persistEnabled" type="boolean" value="true" />
    <field id="nextEpisode" type="assocarray" />
    <field id="nextEpisodeRequested" type="assocarray" alwaysNotify="true" />
    <field id="liveQueue" type="array" />
    <field id="liveIndex" type="integer" value="0" />
    <field id="channelRequested" type="assocarray" alwaysNotify="true" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PlayerView.brs" />
  <script type="text/brightscript" uri="pkg:/source/ParentalPolicy.brs" />
  <script type="text/brightscript" uri="pkg:/source/LocalState.brs" />
