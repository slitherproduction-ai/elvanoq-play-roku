<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerView" extends="Group">
  <interface>
    <field id="streamUrl" type="string" />
    <field id="contentId" type="string" />
    <field id="contentItem" type="assocarray" />
    <field id="contentTitle" type="string" />
    <field id="contentCategory" type="string" />
    <field id="resumePosition" type="integer" value="0" />
    <field id="persistEnabled" type="boolean" value="true" />
    <field id="skipIntroEnd" type="integer" value="0" />
    <field id="nextEpisode" type="assocarray" />
    <field id="nextEpisodeRequested" type="assocarray" alwaysNotify="true" />
    <field id="liveQueue" type="array" />
    <field id="liveIndex" type="integer" value="0" />
    <field id="liveGuide" type="assocarray" />
    <field id="channelRequested" type="assocarray" alwaysNotify="true" />
    <field id="favoriteRequested" type="assocarray" alwaysNotify="true" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <function name="handleKey" />
    <function name="stopPlayback" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PlayerView.brs" />
  <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/TextUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/ParentalPolicy.brs" />
  <script type="text/brightscript" uri="pkg:/source/StreamFormat.brs" />
  <script type="text/brightscript" uri="pkg:/source/LocalState.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" enableUI="false" />
    <Timer id="osdTimer" duration="5" repeat="false" />
    <Timer id="nextEpisodeTimer" duration="6" repeat="false" />
    <Timer id="retryTimer" duration="2" repeat="false" />

    <!-- OSD: so degradês no topo e embaixo; o vídeo continua visível -->
    <Rectangle id="osdBackground" width="1920" height="1080" color="0x070B1433" />
    <Poster id="topShade" uri="pkg:/images/hero_shade_top.png" width="1920" height="240" />
    <Poster id="bottomShade" uri="pkg:/images/hero_shade_bottom.png" translation="[0,440]" width="1920" height="640" />

    <Label id="backLabel" translation="[64,52]" text="" width="10" height="10" />
    <Label id="hint" translation="[64,52]" text="OK: controles   •   Voltar: sair" width="1400" height="34" />
    <Label id="contentBadge" translation="[1456,52]" text="ELVANOQ PLAY" width="400" height="34" horizAlign="right" />

    <Rectangle id="nextEpisodePanel" translation="[660,420]" width="600" height="176" color="0x0D1422F2" visible="false" />
    <Label id="nextEpisodeTitle" translation="[696,448]" text="PRÓXIMO EPISÓDIO" width="540" height="30" visible="false" />
    <Label id="nextEpisodeHint" translation="[696,492]" width="540" height="80" wrap="true" visible="false" />

    <Label id="nowPlayingLabel" translation="[64,752]" text="REPRODUZINDO" width="800" height="26" />
    <Label id="title" translation="[64,784]" width="1500" height="56" />
    <Label id="liveGuideLabel" translation="[64,846]" width="1500" height="32" visible="false" />

    <Rectangle id="timelineTrack" translation="[64,898]" width="1792" height="6" color="0xF4F8FF40" />
    <Rectangle id="timelineProgress" translation="[64,898]" width="0" height="6" color="0x00D7FFFF" />
    <Label id="timeLabel" translation="[64,914]" width="700" height="30" />
    <Label id="trackStatus" translation="[856,914]" width="1000" height="30" horizAlign="right" />

    <Rectangle id="controlFocus" translation="[240,958]" width="160" height="56" color="0xF4F8FFFF" />
    <Label id="controlBack" translation="[64,958]" text="-10s" width="160" height="56" horizAlign="center" vertAlign="center" />
    <Label id="controlPlay" translation="[240,958]" text="Pausar" width="160" height="56" horizAlign="center" vertAlign="center" />
    <Label id="controlForward" translation="[416,958]" text="+10s" width="160" height="56" horizAlign="center" vertAlign="center" />
    <Label id="controlAudio" translation="[592,958]" text="Áudio" width="160" height="56" horizAlign="center" vertAlign="center" />
    <Label id="controlSubtitles" translation="[768,958]" text="Legendas" width="160" height="56" horizAlign="center" vertAlign="center" />
    <Label id="controls" translation="[1256,972]" width="600" height="30" horizAlign="right" />

    <Rectangle id="trackPanel" width="1" height="1" color="0x00000000" visible="false" />
    <Label id="trackPanelTitle" width="1" height="1" visible="false" />
    <Label id="trackPanelValue" width="1" height="1" visible="false" />
  </children>
</component>
